# Chaîne de connexion PostgreSQL (Render)
# Local/développement : URL externe
# Déploiement Render : URL interne (dpg-…-a sans domaine)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_base

# ===== Envoi de SMS (Twilio) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ===== Envoi d'emails (SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EYESHOME <eyeshome@example.com>
